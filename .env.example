# Copie este arquivo para .env e preencha com as suas credenciais do Firebase.
# NUNCA commite o arquivo .env — ele já está no .gitignore.
#
# Como obter esses valores:
#   1. Acesse https://console.firebase.google.com
#   2. Crie ou abra seu projeto
#   3. Vá em Configurações do projeto (⚙️) > Geral > Seus apps > SDK
#   4. Copie o objeto firebaseConfig e preencha abaixo

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
